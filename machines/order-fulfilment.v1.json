{
  "machine": "order-fulfilment",
  "version": 1,
  "initial": "RECEIVED",
  "states": {
    "RECEIVED": {
      "on": {
        "ORDER_ACCEPTED": { "target": "CHECKING_STOCK" }
      }
    },
    "CHECKING_STOCK": {
      "tasks": ["inspect_inventory"],
      "decide": {
        "STOCK_AVAILABLE": {
          "target": "PACKING",
          "description": "All ordered items are available and can be packed."
        },
        "STOCK_UNAVAILABLE": {
          "target": "WAITING_STOCK",
          "description": "One or more items need replenishment before packing can begin."
        },
        "NEEDS_REVIEW": {
          "target": "REVIEW",
          "description": "Conflicting inventory information requires a human review."
        }
      }
    },
    "WAITING_STOCK": {
      "on": {
        "STOCK_ARRIVED": { "target": "CHECKING_STOCK" },
        "CANCEL_REQUESTED": { "target": "CANCELLED", "outcome": "CANCELLED" }
      }
    },
    "REVIEW": {
      "on": {
        "REVIEW_RESOLVED": { "target": "CHECKING_STOCK" },
        "ORDER_REJECTED": { "target": "CANCELLED", "outcome": "CANCELLED" }
      }
    },
    "PACKING": {
      "tasks": ["pack_order"],
      "on": {
        "PACKED": { "target": "SHIPPING" }
      }
    },
    "SHIPPING": {
      "tasks": ["arrange_shipping"],
      "on": {
        "DISPATCHED": { "target": "IN_TRANSIT" }
      }
    },
    "IN_TRANSIT": {
      "on": {
        "DELIVERY_CONFIRMED": { "target": "DELIVERED", "outcome": "DELIVERED" },
        "DELIVERY_FAILED": { "target": "DELIVERY_REVIEW" }
      }
    },
    "DELIVERY_REVIEW": {
      "on": {
        "RETRY_APPROVED": { "target": "SHIPPING" },
        "ADDRESS_CORRECTED": { "target": "SHIPPING" }
      }
    },
    "DELIVERED": {
      "final": true
    },
    "CANCELLED": {
      "final": true
    }
  }
}
