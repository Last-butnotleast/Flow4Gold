{
  "machine": "customer-refund",
  "version": 3,
  "initial": "OPEN",
  "states": {
    "OPEN": {
      "on": {
        "RECEIVED": {
          "target": "INVESTIGATING"
        }
      }
    },
    "INVESTIGATING": {
      "tasks": [
        "diagnose"
      ],
      "decide": {
        "REFUND_RECOMMENDED": {
          "target": "AWAITING_APPROVAL",
          "description": "The available evidence supports a refund for this case."
        },
        "NEED_MORE_INFO": {
          "target": "WAITING_CUSTOMER",
          "description": "Required information is missing and must be supplied by the customer."
        },
        "ESCALATE": {
          "target": "HUMAN_REVIEW",
          "description": "The case requires human judgment before it can proceed."
        }
      }
    },
    "WAITING_CUSTOMER": {
      "on": {
        "CUSTOMER_REPLIED": {
          "target": "INVESTIGATING"
        }
      }
    },
    "HUMAN_REVIEW": {
      "tasks": [
        "human_review"
      ],
      "on": {
        "REVIEW_APPROVED": {
          "target": "EXECUTING"
        },
        "REJECTED": {
          "target": "CLOSED",
          "outcome": "REJECTED"
        },
        "NEED_MORE_INFO": {
          "target": "WAITING_CUSTOMER"
        }
      }
    },
    "AWAITING_APPROVAL": {
      "tasks": [
        "request_approval"
      ],
      "on": {
        "APPROVED": {
          "target": "EXECUTING"
        },
        "REJECTED": {
          "target": "CLOSED",
          "outcome": "REJECTED"
        }
      }
    },
    "EXECUTING": {
      "tasks": [
        "issue_refund"
      ],
      "on": {
        "ACTION_COMPLETED": {
          "target": "VERIFYING"
        },
        "ACTION_FAILED": {
          "target": "RECONCILING"
        }
      }
    },
    "VERIFYING": {
      "tasks": [
        "verify_refund"
      ],
      "on": {
        "REFUND_CONFIRMED": {
          "target": "CLOSED",
          "outcome": "REFUNDED"
        },
        "REFUND_UNCONFIRMED": {
          "target": "RECONCILING"
        }
      }
    },
    "RECONCILING": {
      "on": {
        "REFUND_CONFIRMED": {
          "target": "CLOSED",
          "outcome": "REFUNDED"
        }
      }
    },
    "CLOSED": {
      "final": true
    }
  }
}
